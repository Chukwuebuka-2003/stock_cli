
# LLM Provider Configuration
 
# Choose your LLM provider: "groq" (default) or "docker"
# - groq: Uses Groq's cloud API (requires GROQ_API_KEY)
# - docker: Uses Docker Model Runner for local inference (no API key needed)

LLM_PROVIDER=groq

# Groq Configuration (required if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Docker Model Runner Configuration (alternative to Groq)
# Uncomment these if using LLM_PROVIDER=docker
#DOCKER_MODEL_RUNNER_URL=http://localhost:12434/v1
#DOCKER_MODEL_RUNNER_MODEL=ai/qwen2.5:latestQ4_0


# Tavily API Configuration (for market event detection)
TAVILY_API_KEY=your_tavily_api_key_here

# Email Configuration
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=recipient.email@example.com

# Portfolio Positions (JSON format - for GitHub Actions automation)
# Example: PORTFOLIO_POSITIONS=[{"symbol":"AAPL","quantity":10,"purchase_price":150.0},{"symbol":"GOOGL","quantity":5,"purchase_price":2800.0}]
PORTFOLIO_POSITIONS=yours

APP_ENV=production
LOG_LEVEL=INFO

# ChromaDB Docker Configuration (Optional)
# Set CHROMA_HOST if using Docker (default: "localhost" or "8000")
CHROMA_HOST=
CHROMA_PORT=8000


TWELVEDATA_API_KEY=your_twelvedata_key_here

# SEC requires a descriptive user-agent that includes contact info:
# e.g., StockTrackerCLI/1.0 (you@example.com; +1-555-555-5555)
SEC_USER_AGENT="StockTrackerCLI/1.0 (you@example.com)"
SEC_CONTACT_EMAIL=you@example.com
